# Sao chép file này thành .env và điền giá trị thật. KHÔNG commit/nén/gửi file .env.

# Khóa API OpenAI (bắt buộc cho LLM; để trống -> nhánh rule-based)
OPENAI_API_KEY=

# Model agent (router chọn policy dùng cùng model này)
LLM_MODEL=gpt-4o-mini
# Tham số ổn định kết quả (baseline và hệ thống dùng chung)
LLM_TEMPERATURE=0
LLM_SEED=42

# Timeout/thử lại cuộc gọi LLM: giây giữa 2 gói dữ liệu (mặc định 20), số lần SDK thử lại (1), số lần thử lại cả vòng stream (2)
# LLM_TIMEOUT_S=20
# LLM_API_RETRIES=1
# LLM_STREAM_RETRIES=2

# Bộ trích bộ nhớ cuối lượt (LLM structured output). 0 = tắt, chỉ dùng trích bằng luật.
MEMORY_EXTRACTOR_LLM=1

# Mặc định trong code = cấu hình m1_final11/12 (20/11: TTFT p95 2,87 s trên 1×277; thêm RECEIVED_PREFETCH + LOOKUP_BUNDLE). Fast mode tính giá ×1,67.
# Reranker Qwen3-Reranker-0.6B tự bật khi có GPU và model Qwen3 (Reranker + Embedding 0.6B) đã trong cache HF; không thì router LLM + TF-IDF.
# Về cấu hình m1_final7 (rẻ hơn ~4 lần, TTFT p95 5,8 s): bỏ dấu # các dòng dưới.
# LLM_SERVICE_TIER=
# PARALLEL_REQUIRED_TOOLS=off
# VECTOR_BACKEND=tfidf
# READER_PARALLEL_DRAFT=off
# HANDOFF_PREFETCH=off
# PROMPT_CACHE_ORDER=off
# RECEIVED_PREFETCH=off
# LOOKUP_BUNDLE=off

# Tỷ giá quy đổi chi phí token
USD_TO_VND_RATE=25400

# Tùy chọn
# HARNESS_DB_PATH=data/harness_memory.db
# IDENTITY_HASH_SALT=
# ASR_MODEL=base
