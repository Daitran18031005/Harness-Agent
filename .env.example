# Sao chép file này thành .env và điền giá trị thật. KHÔNG commit/nén/gửi file .env.

# Khóa API OpenAI (bắt buộc cho LLM; để trống -> nhánh rule-based)
OPENAI_API_KEY=

# Model agent (router chọn policy dùng cùng model này)
LLM_MODEL=gpt-4o-mini
# Tham số ổn định kết quả (baseline và hệ thống dùng chung)
LLM_TEMPERATURE=0
LLM_SEED=42

# Timeout/thử lại cuộc gọi LLM: giây giữa 2 gói dữ liệu (mặc định 20), số lần SDK thử lại (1), số lần thử lại cả vòng stream (2)
# LLM_TIMEOUT_S=20
# LLM_API_RETRIES=1
# LLM_STREAM_RETRIES=2

# Bộ trích bộ nhớ cuối lượt (LLM structured output). 0 = tắt, chỉ dùng trích bằng luật.
MEMORY_EXTRACTOR_LLM=1

# Tỷ giá quy đổi chi phí token
USD_TO_VND_RATE=25400

# Tùy chọn
# HARNESS_DB_PATH=data/harness_memory.db
# IDENTITY_HASH_SALT=
# VECTOR_BACKEND=tfidf
# ASR_MODEL=base
