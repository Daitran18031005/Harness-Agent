{
 "uid": "harness-agent",
 "title": "Harness Agent — giám sát",
 "tags": [
  "harness",
  "m1"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "editable": true,
 "templating": {
  "list": [
   {
    "name": "source",
    "label": "Nguồn",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(harness_turns_total, source)",
     "refId": "s"
    },
    "refresh": 2,
    "includeAll": true,
    "multi": true,
    "allValue": ".*",
    "current": {
     "text": "All",
     "value": "$__all"
    }
   },
   {
    "name": "run",
    "label": "Lần chạy",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(harness_turns_total{source=~\"$source\"}, run)",
     "refId": "r"
    },
    "refresh": 2,
    "includeAll": true,
    "multi": true,
    "allValue": ".*",
    "current": {
     "text": "All",
     "value": "$__all"
    }
   },
   {
    "name": "config",
    "label": "Cấu hình",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(harness_turns_total{source=~\"$source\"}, config)",
     "refId": "c"
    },
    "refresh": 2,
    "includeAll": true,
    "multi": true,
    "allValue": ".*",
    "current": {
     "text": "All",
     "value": "$__all"
    }
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Lượt đã xử lý",
   "description": "",
